APP_NAME="Skill-Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# On Railway use LOG_STACK=single,stderr so errors appear in the deploy logs.
# LOG_STACK=daily keeps dated storage/logs/laravel-YYYY-MM-DD.log files for LOG_DAILY_DAYS (14) days.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexus
DB_USERNAME=root
DB_PASSWORD=
# Full path to mysqldump when it is not on PATH (XAMPP: C:/xampp/mysql/bin/mysqldump.exe).
# MYSQLDUMP_PATH=mysqldump

# Job alerts: minimum competency match (%), and days before a deadline to send reminders.
# INTERNSHIP_ALERT_MIN_MATCH=50
# INTERNSHIP_DEADLINE_REMINDER_DAYS=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For live notifications and messages: create a free app at pusher.com, set
# BROADCAST_CONNECTION=pusher, fill in the PUSHER_* values below, and set the
# matching VITE_PUSHER_* values (same key/cluster) so the frontend can
# subscribe. Leave BROADCAST_CONNECTION=log and the VITE_* values unset to
# run without live updates — nothing else needs to change.
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
FILESYSTEM_DISK=local
# On Railway, set these to s3_public and s3_private and configure AWS_* above,
# or mount a persistent volume at the storage directory.
PUBLIC_UPLOAD_DISK=public
PRIVATE_UPLOAD_DISK=private
# sync runs queued jobs (notification emails) inside the request. Switch to
# database only once a `php artisan queue:work` process is running.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: log writes emails to storage/logs/laravel.log.
# Railway: MAIL_MAILER=resend, plus RESEND_API_KEY and a MAIL_FROM_ADDRESS on
# your verified Resend domain. Set real values only in Railway Variables.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Secret for hashing IP addresses before they are stored (keep it different from APP_KEY).
# Generate: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
IP_HASH_KEY=

# Industry dropdown (company forms): a free key from oanor.com, used by the server only. Without it a stored list is used.
INDUSTRY_API_KEY=

# Backups (php artisan backup:run, nightly at 02:00): the database and every uploaded file in one AES-256 encrypted
# archive. The password is required (16+ characters); keep a copy of it away from this server, a backup cannot be opened without it.
# Generate: php artisan tinker --execute="echo bin2hex(random_bytes(24));"
BACKUP_PASSWORD=
# Optional second copy of every backup: a folder on another drive or a synced cloud folder, e.g. D:/skillbridge-backups
BACKUP_COPY_PATH=

# Browser protection headers: false = the Content Security Policy only reports (browser console). Set true
# once every role's main pages show no CSP messages. See GOING_LIVE.md.
CSP_ENFORCE=false
# Signs out after 30 idle minutes (staff) or 120 (students). Keep true; false only for automated tests.
IDLE_TIMEOUT=true
# Two-factor sign-in (admins always, others optional): the code step is skipped when APP_ENV=local so demos are
# never blocked. Set false to try the real flow on a development machine. See GOING_LIVE.md.
TWO_FACTOR_SKIP_LOCAL=true
